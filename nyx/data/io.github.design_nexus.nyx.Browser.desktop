[Desktop Entry]
Type=Application
Version=1.5
Name=Browser
GenericName=Web Browser
Comment=Browse the web, with vertical or horizontal tabs
Exec=nyx-browser %U
Icon=io.github.design_nexus.nyx.Browser
Terminal=false
StartupNotify=true
StartupWMClass=io.github.design_nexus.nyx.Browser
Categories=Network;WebBrowser;
Keywords=web;internet;tabs;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=nyx-browser --new-window

[Desktop Action new-private-window]
Name=New Private Window
Exec=nyx-browser --private-window
