+        // Nyx Browser: the page's state, for Browser's shield, which reads the title.
+        let nyx;
+        if ( pageStore !== null ) {
+            const hn = pageStore.tabHostname;
+            const on = name => sessionSwitches.evaluateZ(name, hn);
+            nyx = 'NYX' + JSON.stringify({
+                host: hn,
+                on: state === 1,
+                blocked: pageStore.counts.blocked.any,
+                allowed: pageStore.counts.allowed.any,
+                popups: on('no-popups'),
+                largeMedia: on('no-large-media'),
+                cosmetic: on('no-cosmetic-filtering'),
+                fonts: on('no-remote-fonts'),
+                scripts: on('no-scripting'),
+            });
+        }
+
+        vAPI.setIcon(tabId, { parts, state, badge, color, nyx });
     };
 
     // parts: bit 0 = icon
