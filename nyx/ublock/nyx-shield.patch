diff -ruN '--exclude=META-INF' a/js/commands.js b/js/commands.js
--- a/js/commands.js	1979-12-31 00:00:00.000000000 -0600
+++ b/js/commands.js	2026-11-13 14:35:38.857960137 -0600
@@ -168,12 +168,45 @@
         });
         break;
     case 'toggle-javascript':
+    case 'nyx-toggle-scripts':
         µb.toggleHostnameSwitch({
             name: 'no-scripting',
             hostname: hostnameFromURI(µb.normalizeTabURL(tab.id, tab.url)),
         });
         vAPI.tabs.reload(tab.id);
         break;
+    // Nyx Browser's shield: blocking on or off for the site, and the site's switches.
+    case 'nyx-toggle-site': {
+        // As the popup's big switch: on for the whole site, or off (trusted).
+        const pageStore = µb.pageStoreFromTabId(tab.id);
+        if ( pageStore === null ) { break; }
+        pageStore.toggleTrustedStatus(
+            µb.normalizeTabURL(tab.id, tab.url),
+            '',
+            pageStore.isTrusted() === false
+        );
+        µb.updateToolbarIcon(tab.id, 0b111);
+        vAPI.tabs.reload(tab.id);
+        break;
+    }
+    case 'nyx-toggle-popups':
+    case 'nyx-toggle-large-media':
+    case 'nyx-toggle-cosmetic':
+    case 'nyx-toggle-fonts': {
+        const name = {
+            'nyx-toggle-popups': 'no-popups',
+            'nyx-toggle-large-media': 'no-large-media',
+            'nyx-toggle-cosmetic': 'no-cosmetic-filtering',
+            'nyx-toggle-fonts': 'no-remote-fonts',
+        }[command];
+        µb.toggleHostnameSwitch({
+            name,
+            hostname: hostnameFromURI(µb.normalizeTabURL(tab.id, tab.url)),
+        });
+        µb.updateToolbarIcon(tab.id, 0b111);
+        if ( name !== 'no-cosmetic-filtering' ) { vAPI.tabs.reload(tab.id); }
+        break;
+    }
     default:
         break;
     }
