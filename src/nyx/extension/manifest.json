{
  "manifest_version": 3,
  "name": "Nyx Integration",
  "description": "Share, Capture and Assistant from the Nyx apps on this computer, and a new tab page.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "nyx-integration@design-nexus.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": { "scripts": ["background.js"] },
  "permissions": ["nativeMessaging", "activeTab", "scripting", "contextMenus", "downloads", "topSites", "history", "tabs", "storage", "search", "notifications"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "sidebar_action": {
    "default_title": "Assistant",
    "default_panel": "panel.html",
    "default_icon": "icons/assistant.svg",
    "open_at_install": false
  },
  "commands": {
    "share-page": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Share this page" },
    "capture-page": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Capture this page" },
    "open-assistant": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Open Assistant" }
  },
  "icons": { "48": "icons/assistant.svg" }
}
