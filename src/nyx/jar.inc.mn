% resource nyx %content/browser/nyx/

        content/browser/nyx/NyxPreloaded.js                  (../../nyx/NyxPreloaded.js)
        content/browser/nyx/NyxTheme.sys.mjs                 (../../nyx/modules/NyxTheme.sys.mjs)
        content/browser/nyx/modules/                         (../../nyx/modules/*.js)
        content/browser/nyx/styles/                          (../../nyx/styles/*.css)
        content/browser/nyx/icons/                           (../../nyx/icons/*.svg)
        content/browser/nyx/extension/                       (../../nyx/extension/*.*)
        content/browser/nyx/extension/icons/                 (../../nyx/extension/icons/*.svg)
